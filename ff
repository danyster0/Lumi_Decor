
        /* === Sidebar Responsive Control === */
.sidebar {
    position: fixed;
    top: 0;
    right: 0;
    width: 250px;
    height: 100vh; /* يخليه بطول الشاشة */
    background-color: #fff;
    box-shadow: -2px 0 5px rgba(0, 0, 0, 0.1);
    transform: translateX(100%);
    transition: transform 0.3s ease;
    z-index: 0;
    padding: 20px;
    overflow-y: auto; /* لو القائمة طولت يكون فيها Scroll داخلي */
}

.sidebar.show {
    transform: translateX(0);
}

.sidebar .close-btn {
    display: none;
    font-size: 20px;
    cursor: pointer;
    margin-bottom: 20px;
}

@media (max-width: 768px) {
    .sidebar {
        display: block;
    }

    .sidebar .close-btn {
        display: block;
    }

    .sidebar-menu {
        padding: 0;
    }

    .sidebar-menu li {
        list-style: none;
        margin-bottom: 15px;
    }
}

@media (min-width: 769px) {
    .sidebar {
        transform: translateX(0);
        position: relative;
        box-shadow: none;
        width: 200px;
    }

    .sidebar .close-btn {
        display: none;
    }

    .menu-btn {
        display: none;
    }
}
